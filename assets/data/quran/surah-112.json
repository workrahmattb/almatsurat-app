{
  "id": 112,
  "name_arabic": "ٱلْإِخْلَاص",
  "name_latin": "Al-Ikhlas",
  "translation_id": "Pengesaan",
  "total_ayat": 4,
  "ayat": [
    {
      "number": 1,
      "arabic": "قُلْ هُوَ ٱللَّهُ أَحَدٌ",
      "translation": "Katakanlah: \"Dia Allah Yang Maha Esa.\""
    },
    {
      "number": 2,
      "arabic": "ٱللَّهُ ٱلصَّمَدُ",
      "translation": "Allah Tempat bergantung."
    },
    {
      "number": 3,
      "arabic": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
      "translation": "Dia tidak beranak dan tidak pula diperanakkan."
    },
    {
      "number": 4,
      "arabic": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ",
      "translation": "Dan tidak ada sesuatu yang setara dengan Dia."
    }
  ]
}
